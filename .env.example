# Copy to .env and fill in real values before running `docker compose up -d --build`

# MySQL root password + database name (backend connects as root)
DB_PASSWORD=change-me
DB_NAME=web_ruou

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed to call the API (nginx serves it on :8080 by default)
CORS_ORIGIN=http://localhost:8080

# development keeps TypeORM synchronize=true (auto-creates tables — this project
# has no migrations yet). Switch to production only after the schema exists.
NODE_ENV=development
